---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="Page not found | Shon DeCamp">
  <div style="max-width: 40rem; margin: 12vh auto; padding: 0 var(--gutter); text-align: center;">
    <p class="ds-eyebrow">404</p>
    <h1>Page not found</h1>
    <p>That page has moved or no longer exists.</p>
    <p style="display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: center;">
      <Button href="/">Go to the home page</Button>
      <Button href="/Shon DeCamp Resume.pdf" variant="secondary">View resume</Button>
    </p>
  </div>
</BaseLayout>
