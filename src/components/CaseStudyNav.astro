---
// Previous / next case study links plus a way back to all work.
import { caseStudies } from '../data/case-studies';
interface Props {
  href: string;
}
const i = caseStudies.findIndex((c) => c.href === Astro.props.href);
const prev = i > 0 ? caseStudies[i - 1] : undefined;
const next = i >= 0 && i < caseStudies.length - 1 ? caseStudies[i + 1] : undefined;
---
<nav class="site-case-nav" aria-label="More case studies">
  {prev ? <a class="site-case-prev" href={prev.href}><span>Previous</span>{prev.title}</a> : <span />}
  <a class="site-case-all" href="/#work">All work</a>
  {next ? <a class="site-case-next" href={next.href}><span>Next</span>{next.title}</a> : <span />}
</nav>
