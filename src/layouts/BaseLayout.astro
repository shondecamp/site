---
// Shared <head>, header and footer for every page. Edit site-wide meta, fonts,
// navigation and contact details here (or in src/components) once.
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces/opsz.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

interface Props {
  title: string;
  description?: string;
  bodyStyle?: string;
  /** True on the home page, so nav links scroll instead of reloading. */
  home?: boolean;
  /** True keeps the page out of search results (e.g. the style guide). */
  noindex?: boolean;
}

const {
  title,
  description = 'Portfolio of Shon DeCamp.',
  bodyStyle,
  home = false,
  noindex = false,
} = Astro.props;
// Match the sitemap: clean URLs without .html (GitHub Pages serves both forms).
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), Astro.site);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbfaf7" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shon DeCamp" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <slot name="head" />
  </head>
  <body style={bodyStyle}>
    <a class="site-skip" href="#main">Skip to content</a>
    <SiteHeader home={home} />
    <main id="main" class="site-main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
